{#-
  Minimal chat template for base models that ship none (e.g. facebook/opt-125m).
  It deterministically serializes the OpenAI-style `messages` list into a single
  plain-text prompt: one "Role: content" line per message, then a trailing
  "Assistant:" cue for generation. The exact format does not matter for the KV
  caching demo — what matters is that identical leading messages always render
  to the identical token prefix, which is what lets LMCache reuse cached KV.
-#}
{% for message in messages -%}
{% if message['role'] == 'system' -%}
System: {{ message['content'] }}
{% elif message['role'] == 'user' -%}
User: {{ message['content'] }}
{% elif message['role'] == 'assistant' -%}
Assistant: {{ message['content'] }}
{% endif -%}
{% endfor -%}
{% if add_generation_prompt -%}
Assistant:
{%- endif %}
