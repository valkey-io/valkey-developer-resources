# Copy this file to .env and adjust values as needed.
# Do not commit a real .env file — .gitignore already excludes it.

# --- Valkey connection (read by ValkeyMemoryConfig in valkey_memory.py) ---
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_REQUEST_TIMEOUT_MS=5000

# --- Embedding provider (optional) ---
# The default provider (LocalDeterministicEmbedding) needs none of the
# variables below — it is local, deterministic, and requires no network
# access or API key. Set one of the following only if you want to use a
# real semantic embedding provider from embeddings.py.

# OpenAIEmbedding: requires `pip install openai==1.54.4` (not installed by
# default) and this API key. Get a key from https://platform.openai.com/api-keys
# OPENAI_API_KEY=

# OllamaEmbedding: requires a running local Ollama server
# (https://ollama.com) with an embedding model pulled, e.g.
# `ollama pull nomic-embed-text`. No API key needed.
# OLLAMA_HOST=http://127.0.0.1:11434
