# Copy to .env and fill in your values: cp .env.example .env
# The sample loads this file automatically via python-dotenv.

# Optional: set this to use OpenAI embeddings instead of deterministic local vectors.
# OPENAI_API_KEY=sk-your-key-here

# Optional OpenAI model override.
# EMBED_MODEL=text-embedding-3-small
# If you choose a different model, set its output dimension too.
# OPENAI_EMBEDDING_DIM=1536

# Optional: Valkey connection (defaults shown)
VALKEY_HOST=localhost
VALKEY_PORT=6379
