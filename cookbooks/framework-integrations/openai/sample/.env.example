# Copy to .env and fill in your values: cp .env.example .env
# The sample loads this file automatically via python-dotenv.

# Required: your OpenAI API key (https://platform.openai.com/account/api-keys)
OPENAI_API_KEY=sk-your-key-here

# Optional: Valkey connection (defaults shown)
VALKEY_HOST=localhost
VALKEY_PORT=6379
