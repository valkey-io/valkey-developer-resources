<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.valkey.samples</groupId>
    <artifactId>langchain4j-valkey-cookbook</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>LangChain4j + Valkey Cookbook Sample</name>
    <description>Sample code for the LangChain4j + Valkey cookbook series</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!--
            Version strategy:
            - langchain4j.version: core langchain4j (released on Maven Central)
            - langchain4j-community.version: community modules incl. valkey store (beta track)
            - langchain4j-beta.version: extension modules released as beta (embeddings, etc.)
            Update all three when langchain4j-community-valkey reaches a stable Maven Central release.
        -->
        <langchain4j.version>1.15.0</langchain4j.version>
        <langchain4j-community.version>1.15.0-beta25</langchain4j-community.version>
        <langchain4j-beta.version>1.15.0-beta25</langchain4j-beta.version>
    </properties>

    <dependencies>
        <!-- LangChain4j core -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
            <version>${langchain4j.version}</version>
        </dependency>

        <!-- Valkey embedding store -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-community-valkey</artifactId>
            <version>${langchain4j-community.version}</version>
            <exclusions>
                <!-- Exclude the wrong-platform glide jar pulled transitively -->
                <exclusion>
                    <groupId>io.valkey</groupId>
                    <artifactId>valkey-glide</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Valkey GLIDE client — use the correct platform classifier -->
        <!-- Change classifier to linux-x86_64, linux-aarch_64, etc. for other platforms -->
        <dependency>
            <groupId>io.valkey</groupId>
            <artifactId>valkey-glide</artifactId>
            <version>2.3.1</version>
            <classifier>osx-aarch_64</classifier>
        </dependency>

        <!-- Local embedding model (no API key needed) -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-embeddings-all-minilm-l6-v2</artifactId>
            <version>${langchain4j-beta.version}</version>
        </dependency>

        <!-- Amazon Bedrock for embeddings and chat (RAG pipeline) -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-bedrock</artifactId>
            <version>${langchain4j.version}</version>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.13</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.3.0</version>
            </plugin>
        </plugins>
    </build>
</project>
