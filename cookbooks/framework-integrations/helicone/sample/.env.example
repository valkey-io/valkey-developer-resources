# Valkey connection settings
# When VALKEY_HOST is omitted, the application falls back to in-process memory caching
VALKEY_HOST=localhost         # Valkey hostname (omit for in-process fallback)
VALKEY_PORT=6379              # Valkey port number (default: 6379)
VALKEY_TLS=false              # Enable TLS for Valkey connections (true/false)
VALKEY_AUTH=                  # Valkey AUTH password (leave empty if no auth required)
