# Copy to .env and fill in your values: cp .env.example .env
# The scripts read this via os.environ; export it into your shell or use python-dotenv.

# Valkey connection
VECTOR_DB_URL=valkey://localhost:6379

# Ollama is the default LLM/embedding provider (no key needed, see 01-getting-started.md).
# Uncomment to use OpenAI instead:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-your-key-here
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536

# Uncomment to use Amazon Bedrock instead (requires AWS credentials + Bedrock model access):
# LLM_PROVIDER=bedrock
# LLM_MODEL=bedrock/us.anthropic.claude-sonnet-4-5-20250929-v1:0
# EMBEDDING_PROVIDER=bedrock
# EMBEDDING_MODEL=bedrock/amazon.titan-embed-text-v2:0
# EMBEDDING_DIMENSIONS=1024
# AWS_REGION=us-east-1
