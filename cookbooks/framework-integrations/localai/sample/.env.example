# Copy to .env and adjust. All values have working defaults; the sample runs
# with no .env at all against a local LocalAI + Valkey.

# LocalAI server base URL.
LOCALAI_BASE_URL=http://localhost:8080

# Store backend: "valkey-store" (or the "valkey" alias) routes to Valkey.
STORE_BACKEND=valkey-store

# Store namespace ("table" name); isolated keyspace + index in Valkey.
STORE_NAME=cookbook-demo

# Per-request HTTP timeout in seconds. Raise for slow networks or large batches.
REQUEST_TIMEOUT=5.0
