{
  "theme": "base",
  "look": "classic",
  "htmlLabels": false,
  "fontFamily": "Arial, Helvetica, sans-serif",
  "themeVariables": {
    "fontFamily": "Arial, Helvetica, sans-serif",
    "fontSize": "15px",
    "background": "#ffffff",
    "primaryColor": "#f8fafc",
    "primaryBorderColor": "#475569",
    "primaryTextColor": "#0f172a",
    "lineColor": "#475569",
    "textColor": "#0f172a",
    "clusterBkg": "#ffffff",
    "clusterBorder": "#94a3b8",
    "edgeLabelBackground": "#ffffff",
    "noteBkgColor": "#f8fafc",
    "noteBorderColor": "#475569",
    "noteTextColor": "#0f172a",
    "actorBkg": "#f8fafc",
    "actorBorder": "#475569",
    "actorTextColor": "#0f172a",
    "signalColor": "#0f172a",
    "signalTextColor": "#0f172a",
    "labelBoxBkgColor": "#f8fafc",
    "labelBoxBorderColor": "#475569"
  },
  "flowchart": {
    "htmlLabels": false,
    "curve": "basis",
    "padding": 12,
    "wrappingWidth": 500,
    "nodeSpacing": 40,
    "rankSpacing": 50,
    "useMaxWidth": false
  },
  "sequence": {
    "useMaxWidth": false,
    "wrap": false,
    "actorMargin": 40,
    "messageFontSize": 15,
    "noteFontSize": 14,
    "actorFontSize": 15
  }
}
