# Copy to .env to override run-benchmark.sh and compose.yaml defaults. .env is
# gitignored.

# Ungated model, so no Hugging Face token is needed. If you switch to a gated
# model, set HF_TOKEN here and keep .env out of version control.
MODEL=Qwen/Qwen3-8B
# HF_TOKEN=

# Shared model cache on the host (reused across runs).
# HF_CACHE=./.hf-cache

# Where the run happened, recorded in metadata.json and printed above every
# results table. The optional AWS Terraform writes these to
# /etc/llm-d-gpu-bench/host.env for you.
# BENCH_CLOUD=
# BENCH_INSTANCE_TYPE=
# BENCH_REGION=

# vLLM sizing. MAX_NUM_BATCHED_TOKENS is also the calibration chunk size.
# GPU_MEMORY_UTILIZATION=0.90
# MAX_MODEL_LEN=16384
# MAX_NUM_BATCHED_TOKENS=8192
# Set DTYPE=half on GPUs without bfloat16, such as the T4.
# DTYPE=auto

# Skip calibration by setting a value you measured earlier.
# PEAK_PREFILL_THROUGHPUT=

# Valkey. maxmemory must hold one run's KV (README.md, "Sizing Valkey").
# VALKEY_MAXMEMORY=192gb

# LMCache server. L1 is host memory; skip_l1 removes chunks from it once they
# are in Valkey, so KV loads come from Valkey.
# LMCACHE_L1_SIZE_GB=16
# LMCACHE_EVICTION_POLICY=noop
# LMCACHE_L2_STORE_POLICY=skip_l1
# Transfer between the replicas and the server. auto uses CUDA IPC
# (lmcache_driven) on GPUs. If that fails between containers, set
# LMCACHE_MP_TRANSFER_MODE=engine_driven and keep the server at auto.
# LMCACHE_SERVER_TRANSFER_MODE=auto
# LMCACHE_MP_TRANSFER_MODE=auto

# Flush the router's index (Valkey database 1) before each run, so
# precise-valkey starts as empty as precise-memory. Set to 0 to keep it.
# FLUSH_ROUTER_INDEX=1

# Host RAM the preflight reserves per replica, for the LMCache server process
# (besides L1), and for everything else, in GiB.
# REPLICA_HOST_RAM_GIB=16
# LMCACHE_SERVER_HOST_RAM_GIB=8
# SYSTEM_HOST_RAM_GIB=16

# Configurations, repeats and workload.
# STRATEGIES="random-no-lmcache random approximate precise-memory precise-valkey"
# RUNS=3
# CONCURRENCY_LEVELS="8 16 32"
# WARMUP_REQUESTS=384
# STAGE_REQUESTS=768
# NUM_PREFIXES=192
# PROMPTS_PER_PREFIX=4
# SYSTEM_PROMPT_LEN=4096
# QUESTION_LEN=256
# OUTPUT_LEN=64
# SEED=42
