#!/bin/bash
# Runs once, on first boot. Installs an auto-stop backstop that re-arms on
# every boot, makes sure the Docker Compose plugin is present, and optionally
# clones the repo that holds the benchmark stack. Holds no secrets.
set -euo pipefail

AUTO_STOP_MINUTES=${auto_stop_minutes}
REPO_URL='${repo_url}'
REPO_REF='${repo_ref}'
REPO_DIR=/opt/bench/repo

if [ "$AUTO_STOP_MINUTES" -gt 0 ]; then
  cat >/etc/systemd/system/auto-stop.service <<EOF
[Unit]
Description=Shut down $AUTO_STOP_MINUTES minutes after boot (cost backstop)
After=multi-user.target

[Service]
Type=oneshot
ExecStart=/usr/sbin/shutdown -h +$AUTO_STOP_MINUTES "auto-stop: $AUTO_STOP_MINUTES min after boot"
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
  systemctl enable --now auto-stop.service
fi

# The rest is best effort: log failures instead of aborting, so a missing
# package doesn't leave the host without the bootcheck log.
set +e
{
  # The benchmark is driven by `docker compose`.
  if ! docker compose version; then
    apt-get update && apt-get install -y docker-compose-plugin
    docker compose version || echo "docker compose plugin missing"
  fi

  if [ -n "$REPO_URL" ]; then
    mkdir -p "$(dirname "$REPO_DIR")"
    git clone --depth 1 --branch "$REPO_REF" "$REPO_URL" "$REPO_DIR" || echo "git clone failed"
  fi

  # Confirm the GPU stack the benchmark relies on is present.
  nvidia-smi || echo "nvidia-smi failed"
  docker info --format 'docker {{.ServerVersion}} runtimes:{{range $name, $_ := .Runtimes}} {{$name}}{{end}}' || echo "docker info failed"

  # Where this host runs, for the benchmark's metadata.json. run-benchmark.sh
  # reads this file if it exists; the benchmark itself has no AWS-specific
  # code. Values come from instance metadata (IMDSv2).
  imds_token="$(curl -fsS -X PUT http://169.254.169.254/latest/api/token -H 'X-aws-ec2-metadata-token-ttl-seconds: 300')"
  imds() { curl -fsS -H "X-aws-ec2-metadata-token: $imds_token" "http://169.254.169.254/latest/meta-data/$1"; }
  mkdir -p /etc/llm-d-gpu-bench
  {
    echo "BENCH_CLOUD=aws"
    echo "BENCH_INSTANCE_TYPE=$(imds instance-type)"
    echo "BENCH_REGION=$(imds placement/region)"
  } > /etc/llm-d-gpu-bench/host.env
  cat /etc/llm-d-gpu-bench/host.env
} >/var/log/gpu-bench-bootcheck.log 2>&1
