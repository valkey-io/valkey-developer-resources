# Copy to .env to override run-benchmark.sh defaults. .env is gitignored.

# Ungated model, so no Hugging Face token is needed. If you switch to a gated
# model, set HF_TOKEN here and keep .env out of version control.
MODEL=Qwen/Qwen3-8B
# HF_TOKEN=

# Shared model cache on the host (reused across runs).
# HF_CACHE=./.hf-cache

# vLLM sizing for 24 GB GPUs. MAX_NUM_BATCHED_TOKENS is also the calibration
# chunk size.
# GPU_MEMORY_UTILIZATION=0.90
# MAX_MODEL_LEN=16384
# MAX_NUM_BATCHED_TOKENS=8192
# DTYPE=auto   # set to "half" on GPUs without bfloat16, such as the T4

# Skip calibration by setting a value you measured earlier.
# PEAK_PREFILL_THROUGHPUT=

# Workload.
# STRATEGIES="random approximate precise-memory precise-valkey"
# CONCURRENCY_LEVELS="8 16 32"
# WARMUP_REQUESTS=128
# STAGE_REQUESTS=512
# NUM_PREFIXES=16
# PROMPTS_PER_PREFIX=64
# SYSTEM_PROMPT_LEN=4096
# QUESTION_LEN=256
# OUTPUT_LEN=64
# SEED=42
