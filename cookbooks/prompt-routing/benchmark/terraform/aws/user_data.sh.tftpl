#!/bin/bash
# Runs once, on first boot. Installs an auto-stop backstop that re-arms on
# every boot. Holds no secrets.
set -euo pipefail

AUTO_STOP_MINUTES=${auto_stop_minutes}

if [ "$AUTO_STOP_MINUTES" -gt 0 ]; then
  cat >/etc/systemd/system/auto-stop.service <<EOF
[Unit]
Description=Shut down $AUTO_STOP_MINUTES minutes after boot (cost backstop)
After=multi-user.target

[Service]
Type=oneshot
ExecStart=/usr/sbin/shutdown -h +$AUTO_STOP_MINUTES "auto-stop: $AUTO_STOP_MINUTES min after boot"
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
  systemctl enable --now auto-stop.service
fi

# Sanity log: confirm the GPU stack the benchmark relies on is present.
{
  nvidia-smi || echo "nvidia-smi failed"
  docker info --format 'docker {{.ServerVersion}} runtimes={{json .Runtimes}}' || echo "docker info failed"
} >/var/log/gpu-bench-bootcheck.log 2>&1
