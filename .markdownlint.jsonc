{
  // Reasonable defaults for a samples/cookbook repository
  "MD013": {
    // Allow long lines — tables and URLs frequently exceed 80 chars
    "line_length": 200,
    "tables": false
  },
  // Allow HTML — <nobr> in cookbook README tables and <details>/<summary> for optional (collapsible) sections
  "MD033": {
    "allowed_elements": ["nobr", "br", "details", "summary"]
  },
  // Allow duplicate headings in different sections (e.g., multiple "## Prerequisites")
  "MD024": {
    "siblings_only": true
  },
  // Allow trailing punctuation in headings (e.g., "## Questions?")
  "MD026": {
    "punctuation": ".,;:!"
  }
}
