      {
        "ToolSpecification": {
          "name": "get_document",
          "description": "Retrieve a specific document by ID.\n\n    Args:\n        collection: Collection name\n        document_id: Document ID\n\n    Returns:\n        An object indicating the results of the operation, with a \"status\" field set to either \"success\" or \"error\",\n        and a \"reason\" field (in the event of an error) set to the error reason, otherwise a \"result\" field\n        containing the document, or None if not found\n\n    Example:\n        doc = await get_document(\n            collection=\"research_papers\",\n            document_id=\"paper_123\"\n        )\n    ",
          "input_schema": {
            "json": {
              "title": "get_documentArguments",
              "type": "object",
              "properties": {
                "document_id": {
                  "type": "string",
                  "title": "Document Id"
                },
                "collection": {
                  "type": "string",
                  "title": "Collection"
                }
              },
              "required": [
                "collection",
                "document_id"
              ]
            }
          }
        }
      },
      {
        "ToolSpecification": {
          "name": "semantic_search",
          "description": "Search for documents using natural language queries.\n\n    This tool performs semantic similarity search, finding documents whose meaning\n    is similar to the query text, even if they don't contain the exact same words.\n\n    Args:\n        collection: Collection to search in\n        query: Natural language search query\n        offset: Record offset determining the window slice of results to render (default: 0)\n        limit: Maximum number of results to return (default: 10)\n        include_content: Whether to include full document content (default: True)\n        filter_expression: Optional filter expression to apply to the search results\n\n    Returns:\n        An object indicating the results of the operation, with a \"status\" field set to either \"success\" or \"error\",\n        and a \"reason\" field (in the event of an error) set to the error reason, otherwise a \"results\" field\n        containing a list of matching documents with similarity scores and metadata\n\n    Example:\n        results = await semantic_search(\n            collection=\"research_papers\",\n            query=\"impact of climate change on agriculture\",\n            limit=5\n        )\n        # Returns documents ranked by semantic similarity\n    ",
          "input_schema": {
            "json": {
              "type": "object",
              "title": "semantic_searchArguments",
              "properties": {
                "filter_expression": {
                  "default": null,
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "title": "Filter Expression"
                },
                "limit": {
                  "title": "Limit",
                  "type": "integer",
                  "default": 10
                },
                "offset": {
                  "title": "Offset",
                  "type": "integer",
                  "default": 0
                },
                "include_content": {
                  "type": "boolean",
                  "title": "Include Content",
                  "default": true
                },
                "collection": {
                  "type": "string",
                  "title": "Collection"
                },
                "query": {
                  "title": "Query",
                  "type": "string"
                }
              },
              "required": [
                "collection",
                "query"
              ]
            }
          }
        }
      },
      {
        "ToolSpecification": {
          "name": "vector_search",
          "description": "Perform a Valkey vector search using the FT.SEARCH command.\n\n    This tool performs K-nearest neighbors (KNN) search on vector embeddings stored in Valkey.\n    It finds documents whose vector embeddings are most similar to the provided query vector.\n\n    Args:\n        index: Name of the Valkey search index to use\n        field: Name of the vector field in the index to search against\n        vector: The query vector as a list of floats (must match the dimensionality of indexed vectors)\n        filter_expression: Optional filter expression to apply to the search results\n        offset: Record offset determining the window slice of results to render (default: 0)\n        count: Size of the window slice of results to render (default: 10)\n        no_content: If True, return only document IDs without content (default: False)\n\n    Returns:\n        An object indicating the results of the operation, with a \"status\" field set to either \"success\" or \"error\",\n        and a \"reason\" field (in the event of an error) set to the error reason, otherwise a \"results\" field\n        containing a list of matching documents as dictionaries containing all document fields\n        (excluding the vector field itself), or an error message if there was a failure\n\n    Example:\n        # Search for documents similar to a query vector\n        results = await vector_search(\n            index=\"products_idx\",\n            field=\"description_vector\",\n            vector=[0.1, 0.2, 0.3, ...],  # 768-dimensional vector\n            count=5\n        )\n    ",
          "input_schema": {
            "json": {
              "title": "vector_searchArguments",
              "properties": {
                "count": {
                  "default": 10,
                  "type": "integer",
                  "title": "Count"
                },
                "no_content": {
                  "title": "No Content",
                  "default": false,
                  "type": "boolean"
                },
                "offset": {
                  "type": "integer",
                  "default": 0,
                  "title": "Offset"
                },
                "index": {
                  "type": "string",
                  "title": "Index"
                },
                "vector": {
                  "items": {
                    "type": "number"
                  },
                  "type": "array",
                  "title": "Vector"
                },
                "field": {
                  "type": "string",
                  "title": "Field"
                },
                "filter_expression": {
                  "title": "Filter Expression",
                  "default": null,
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "type": "object",
              "required": [
                "index",
                "field",
                "vector"
              ]
            }
          }
        }
      },
      {
        "ToolSpecification": {
          "name": "stream_info_groups",
