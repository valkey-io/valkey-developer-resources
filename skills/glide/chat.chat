      {
        "ToolSpecification": {
          "name": "getConfluenceSpaces",
          "description": "Get spaces",
          "input_schema": {
            "json": {
              "$schema": "http://json-schema.org/draft-07/schema#",
              "properties": {
                "limit": {
                  "description": "Max results (default: 25, max: 250)",
                  "type": "number"
                },
                "ids": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "number"
                      }
                    }
                  ],
                  "description": "Space IDs"
                },
                "expand": {
                  "anyOf": [
                    {
