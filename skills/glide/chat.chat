              ]
            }
          }
        }
      },
      {
        "ToolSpecification": {
          "name": "add_documents",
          "description": "Add documents to a collection with automatic embedding generation.\n\n    This tool stores documents in a searchable collection, automatically generating\n    vector embeddings from the specified text fields. Documents can contain any fields,\n    but must have an 'id' field.\n\n    The embedding provider is configured via the EMBEDDINGS_PROVIDER environment variable.\n    The embedding dimensions are automatically detected from the provider's output.\n    If embedding_dimensions is not specified, it will be determined from the first\n    embedding generated.\n\n    Args:\n        collection: Name of the collection (e.g., \"research_papers\", \"customer_reviews\")\n        documents: List of documents, each must have an 'id' field\n        text_fields: Fields to use for embedding generation (default: [\"content\"])\n        embedding_dimensions: Vector dimensions (auto-detected if not specified)\n\n    Returns:\n        Summary of the operation including number of documents added and provider info, or in the case\n        of an error, the error message, in a similar structure.  In both cases, the \"status\" and \"added\" fields\n        indicate the overall result of the operation and the number of documents successfully added.\n\n    Example:\n        result = await add_documents(\n            collection=\"research_papers\",\n            documents=[\n                {\n                    \"id\": \"paper_1\",\n                    \"title\": \"AI in Healthcare\",\n                    \"content\": \"Machine learning is transforming medical diagnosis...\",\n                    \"author\": \"Dr. Smith\",\n                    \"year\": 2024\n                }\n            ],\n            text_fields=[\"title\", \"content\"]\n        )\n    ",
          "input_schema": {
            "json": {
              "type": "object",
              "properties": {
                "collection": {
                  "title": "Collection",
                  "type": "string"
                },
                "documents": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "title": "Documents"
                },
                "text_fields": {
                  "title": "Text Fields",
                  "anyOf": [
                    {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null
                },
                "embedding_dimensions": {
                  "title": "Embedding Dimensions",
                  "anyOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null
                }
              },
              "title": "add_documentsArguments",
              "required": [
                "collection",
                "documents"
              ]
            }
          }
        }
      },
      {
        "ToolSpecification": {
          "name": "json_type",
          "description": "Get the type of JSON value at path.\n\n    Args:\n        key: The name of the key\n        path: The path in the JSON document (optional, defaults to root)\n\n    Returns:\n        JSON type or error message\n    ",
          "input_schema": {
