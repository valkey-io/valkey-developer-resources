                "action": {
                  "type": "string",
                  "enum": [
                    "createIssueLink"
                  ],
                  "description": "Write operation to perform."
                },
                "comment": {
                  "description": "Optional comment on the outward issue (Markdown).",
                  "type": "string"
                },
                "cloudId": {
                  "description": "Cloud ID (UUID or site URL)",
                  "type": "string"
                },
                "outwardIssue": {
                  "type": "string",
                  "description": "Outward issue key (e.g. MKY-1). Required for action=createIssueLink."
                }
              }
            }
          }
        }
      },
