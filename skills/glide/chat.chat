      {
        "ToolSpecification": {
          "name": "update_document",
          "description": "Update a single document in a collection by its ID.\n\n    This tool updates an existing document in a collection, regenerating its vector\n    embedding from the specified text fields. The document must have an 'id' field\n    that matches an existing document in the collection.\n\n    Args:\n        collection: Name of the collection\n        document: Document data with 'id' field matching existing document\n        text_fields: Fields to use for embedding generation (default: [\"content\"])\n\n    Returns:\n        Summary of the operation including success status and document info\n\n    Example:\n        result = await update_document(\n            collection=\"research_papers\",\n            document={\n                \"id\": \"paper_1\",\n                \"title\": \"AI in Healthcare - Updated\",\n                \"content\": \"Updated content about machine learning in medical diagnosis...\",\n                \"author\": \"Dr. Smith\",\n                \"year\": 2024\n            },\n            text_fields=[\"title\", \"content\"]\n        )\n    ",
          "input_schema": {
            "json": {
              "title": "update_documentArguments",
              "required": [
                "collection",
                "document"
              ],
              "properties": {
                "document": {
                  "additionalProperties": true,
                  "title": "Document",
                  "type": "object"
                },
                "collection": {
                  "title": "Collection",
                  "type": "string"
                },
                "text_fields": {
                  "anyOf": [
                    {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "title": "Text Fields"
                }
              },
              "type": "object"
            }
          }
        }
      },
      {
        "ToolSpecification": {
          "name": "stream_read",
          "description": "Read entries from stream.\n\n    Args:\n        key: The name of the key\n        count: Maximum number of entries to return\n        block: Milliseconds to block (optional)\n        last_id: Last ID received (default \"$\" for new entries only)\n\n    Returns:\n        List of entries or error message\n    ",
          "input_schema": {
            "json": {
              "required": [
                "key"
              ],
              "properties": {
                "count": {
                  "title": "Count",
                  "default": null,
                  "anyOf": [
